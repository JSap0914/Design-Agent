# Application Configuration
APP_NAME=ANYON Design Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration - PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/anyon_db
DATABASE_SYNC_URL=postgresql://user:password@localhost:5432/anyon_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# LLM Configuration - Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# LLM Configuration - OpenAI (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# GitHub Configuration (for open-source search)
GITHUB_TOKEN=your_github_token_here
GITHUB_API_URL=https://api.github.com

# npm Registry Configuration
NPM_REGISTRY_URL=https://registry.npmjs.org

# Web Search Configuration
WEB_SEARCH_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# LangGraph Configuration
LANGGRAPH_CHECKPOINT_SCHEMA=design_agent
LANGGRAPH_MAX_ITERATIONS=50
LANGGRAPH_RECURSION_LIMIT=100

# Design Agent Configuration
MAX_SCREENS=12
MIN_SCREENS=3
ASCII_UI_WIDTH_MOBILE=40
ASCII_UI_WIDTH_WEB=80
MAX_LAYOUT_OPTIONS=3
MIN_LAYOUT_OPTIONS=2
QUALITY_SCORE_THRESHOLD=90

# BMAD Configuration
REQUIRE_MULTIPLE_OPTIONS=true
REQUIRE_DECISION_RATIONALE=true
MIN_CONTRAST_RATIO=4.5
MIN_TOUCH_TARGET_SIZE=48

# Open-Source Search Configuration
OPENSEARCH_CACHE_TTL=900
OPENSEARCH_MIN_STARS=500
OPENSEARCH_MAX_RESULTS=10
OPENSEARCH_LICENSES=MIT,Apache-2.0
OPENSEARCH_MAX_BUNDLE_SIZE_KB=100
OPENSEARCH_RECENCY_MONTHS=12

# Job Processing Configuration
JOB_POLL_INTERVAL=1.0
JOB_MAX_RETRIES=3
JOB_RETRY_DELAY=5
JOB_TIMEOUT=3600
PROGRESS_UPDATE_INTERVAL=5

# Document Generation Configuration
DOCUMENT_VERSION=0.9
DOCUMENT_FORMAT=markdown
PARALLEL_DOCUMENT_GENERATION=true

# Validation Configuration
ENABLE_TYPESCRIPT_VALIDATION=true
ENABLE_TAILWIND_VALIDATION=true
ENABLE_ACCESSIBILITY_VALIDATION=true
ENABLE_DESIGN_SYSTEM_VALIDATION=true
VALIDATION_STRICT_MODE=false

# WebSocket Configuration (Optional)
ENABLE_WEBSOCKET=false
WEBSOCKET_PORT=8000
WEBSOCKET_PATH=/ws

# API Configuration (Optional)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4
API_CORS_ORIGINS=*

# Monitoring Configuration
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=anyon-design-agent

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Testing Configuration
TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/anyon_test
TEST_REDIS_URL=redis://localhost:6379/1
